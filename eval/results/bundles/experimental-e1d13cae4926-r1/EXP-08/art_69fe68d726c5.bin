        </p>

        <form data-site-feedback-target="form" data-action="submit-&gt;site-feedback#submitForm" novalidate="novalidate" class="simple_form site_feedback" enctype="multipart/form-data" action="/site_feedback" accept-charset="UTF-8" method="post">

          <div class="input string required site_feedback_name"><label class="string required" for="site_feedback_name"><abbr title="required">*</abbr> Your Name</label><input class="string required" required="required" type="text" name="site_feedback[name]" id="site_feedback_name"></div>

