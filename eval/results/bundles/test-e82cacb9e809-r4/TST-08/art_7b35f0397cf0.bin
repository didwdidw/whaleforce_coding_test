gap-10 p-3 lg:p-0"><!--[--><div><h3 id="footer-0" class="text-lg font-semibold leading-[1.2] text-base text-white group"><!----><!--[-->Useful links<!--]--></h3><ul class="mt-3 flex flex-col gap-2" aria-describedby="footer-0"><!--[--><li class="text-base"><a href="https://www.ietf.org" rel="noopener" target="_blank" data-is-hyperlink="" class="underline text-white md:text-nowrap" data-agent-ref="e45"><!--[-->IETF.org<!--]--></a></li><li class="text-base"><a href="https://www.irtf.org" rel="noopener" target="_blank" data-is-hyperlink="" class="underline text-white md:text-nowrap" data-agent-ref="e46"><!--[-->IRTF.org<!--]--></a></li><li class="text-base"><a href="https://www.iab.org" rel="noopener" target="_blank" data-is-hyperlink="" class="underline text-white md:text-nowrap" data-agent-ref="e47"><!--[-->IAB.org<!--]--></a></li><li class="text-base"><a href="https://datatracker.ietf.org" rel="noopener" target="_blank" data-is-hyperlink="" class="underline text-white md:text-nowrap" data-agent-ref="e48"><!--[-->Datatracker<!--]--></a></li><li class="text-base"><a href="https://authors.ietf.org" rel="noopener" target="_blank" data-is-hyperlink="" class="underline text-white md:text-nowrap" data-agent-ref="e49"><!--[-->Author Resources<!--]--></a></li><!--]--></ul></div><div><h3 id="footer-1" class="text-lg font-semibold leading-[1.2] text-base text-white group"><!----><!--[-->Contact Us<!--]--></h3><ul class="mt-3 flex flex-col gap-2" aria-describedby="footer-1"><!--[--><li class="text-base"><a href="/about/contact/" class="underline text-white md:text-nowrap" data-is-nuxt-link="" data-agent-ref="e28"><!--[-->RFC Editor<!--]--></a></li><li class="text-base"><a href="https://mailman.rfc-editor.org/mailman/listinfo/rfc-dist" rel="noopener" target="_blank" data-is-hyperlink="" class="underline text-white md:text-nowrap" data-agent-ref="e29"><!--[-->rfc-dist Info Page<!--]--></a></li><li class="text-base"><a href="https://mailman.rfc-editor.org/mailman/listinfo/rfc-interest" rel="noopener" target="_blank" data-is-hyperlink="" class="underline text-white md:text-nowrap" data-agent-ref="e30"><!--[-->rfc-interest Info Page<!--]--></a></li><!--]--></ul></div><!--]--></div></nav><a class="opacity-0 pointer-events-none fixed top-1 right-2 text-black font-bold rounded-b z-100 bg-white hover:text-white focus:text-white hover:bg-blue-300 dark:bg-black dark:hover:bg-blue-500 border border-gray-200 dark:border-gray-600 px-3 py-2 font-lg transition-opacity print:hidden shadow-lg dark:shadow-blue-900 dark:text-white focus:opacity-100 focus:pointer-events-auto" href="#top" aria-label="Go to top of page"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" role="img" aria-hidden="true" class="inline-block rotate-90"><title>Expand sidebar</title><path d="M4.94598 8.47687L8.16206 11.8124C8.28266 11.9375 8.44347 12 8.60427 12C8.78518 12 8.94598 11.9375 9.06658 11.8124C9.32789 11.5622 9.32789 11.1244 9.06658 10.8743L6.95603 8.66449H13.1068C13.4686 8.66449 13.75 8.37264 13.75 7.99739C13.75 7.643 13.4686 7.33029 13.1068 7.33029H6.95603L9.06658 5.14137C9.32789 4.89121 9.32789 4.45342 9.06658 4.20326C8.82538 3.93225 8.40327 3.93225 8.16206 4.20326L4.94598 7.53876C4.68467 7.78892 4.68467 8.22671 4.94598 8.47687Z"></path><rect width="1.5" height="10" transform="matrix(-1 0 0 1 3.75 3)"></rect></svg></a></footer></div></div><!--]--><!--]--></div><div id="teleports"></div><script>window.__NUXT__={};window.__NUXT__.config={public:{datatrackerBase:"https://datatracker.ietf.org",siteBase:"https://www.rfc-editor.org",apiV1Base:"https://www.rfc-editor.org",errataBase:"https://errata.rfc-editor.org",queueBase:"https://queue.rfc-editor.org",iadBase:"https://iad.rfc-editor.org",dashboardBase:"https://dashboard.rfc-editor.org",matomoSiteId:13,typesenseApiKey:"0C8Exv9grP2li1fwQeg34nPtKfccC3Qa",typesenseHost:"typesense.ietf.org",websiteVersion:"1.69.0",piniaPluginPersistedstate:{}},app:{baseURL:"/",buildId:"0208fd34-790d-4d56-a3fb-fe4a8b43306f",buildAssetsDir:"/_nuxt/1.69.0/",cdnURL:""}}</script><script type="application/json" data-nuxt-data="nuxt-app" data-ssr="true" id="__NUXT_DATA__">[["ShallowReactive",1],{"data":2,"state":2852,"once":2856,"_errors":2857,"serverRendered":117,"path":2859,"pinia":2860},["ShallowReactive",3],{"$oQk39TZTLu":4,"markdown-card-series\u002Frfc":158,"markdown-card-series\u002Frfc-errata":386,"markdown-card-about\u002Frfc-editor":580,"markdown-card-series\u002Frfc-tips":1121,"markdown-card-series\u002Frfc-download":1675,"markdown-card-authors\u002Frfc-independent-submissions":2040},{"homepageLatest":5,"timestampIso":157},[6,64,102],{"formats":7,"number":18,"abstract":19,"published":20,"status":21,"pages":24,"authors":25,"group":39,"area":43,"stream":46,"identifiers":49,"obsoletes":53,"obsoleted_by":54,"updated_by":55,"subseries":56,"updates":59,"keywords":60,"title":63},[8,10,12,14,16],{"format":9},"xml",{"format":11},"txt",{"format":13},"html",{"format":15},"pdf",{"format":17},"json",10026,"Enabling support for automatic acceptance of DNSSEC Delegation Signer (DS) parameters from the Child DNS operator (via RFCs 7344, 8078, and 9615) requires the Parental Agent, often a registry or registrar, to make a number of technical decisions around acceptance checks, error and success reporting, and multi-party issues such as concurrent updates. This document describes recommendations about how these points are best addressed in practice.","2026-07-23",{"slug":22,"name":23},"bcp","best current practice",21,[26,33],{"titlepage_name":27,"is_editor":28,"person":29,"email":30,"affiliation":31,"country":31,"datatracker_person_path":32},"S. Sheng",false,112587,"steve.sheng@icann.org","","\u002Fperson\u002FSteve%20Sheng",{"titlepage_name":34,"is_editor":28,"person":35,"email":36,"affiliation":37,"country":31,"datatracker_person_path":38},"P. Thomassen",127983,"peter@desec.io","deSEC","\u002Fperson\u002FPeter%20Thomassen",{"acronym":40,"name":41,"type":42},"dnsop","Domain Name System Operations","wg",{"acronym":44,"name":45},"ops","Operations and Management Area",{"slug":47,"name":47,"description":48},"IETF","Internet Engineering Task Force (IETF)",[50],{"type":51,"value":52},"doi","10.17487\u002FRFC10026",[],[],[],[57],{"type":22,"number":58},246,[],[61,62],"DNS","DS","Operational Recommendations for DNSSEC Delegation Signer (DS) Automation",{"formats":65,"number":71,"abstract":72,"published":20,"status":73,"pages":76,"authors":77,"group":84,"area":87,"stream":90,"identifiers":91,"obsoletes":94,"obsoleted_by":95,"updated_by":96,"subseries":97,"updates":98,"keywords":99,"title":101},[66,67,68,69,70],{"format":17},{"format":9},{"format":11},{"format":13},{"format":15},9997,"YANG-CBOR (RFC 9254, \"Encoding of Data Modeled with YANG in the Concise Binary Object Representation (CBOR)\") defines YANG Schema Item iDentifiers (YANG SIDs), globally unique 63-bit unsigned integers used to identify YANG items. RFC 9595 (\"YANG Schema Item iDentifier (YANG SID)\") defines ways to allocate these SIDs using IANA registries.\n\nThe present specification employs these SID allocation mechanisms to allocate ranges of 100 000 SIDs (representation size 64 bits) to each holder of an IANA Private Enterprise Number (PEN) of a value below 1 000 000. Holders of PENs of values smaller than 100 000 are also allocated ranges of 10 000 SIDs (representation size 32 bits).",{"slug":74,"name":75},"ps","proposed standard",6,[78],{"titlepage_name":79,"is_editor":28,"person":80,"email":81,"affiliation":82,"country":31,"datatracker_person_path":83},"C. Bormann",11843,"cabo@tzi.org","Universität Bremen TZI","\u002Fperson\u002FCarsten%20Bormann",{"acronym":85,"name":86,"type":42},"core","Constrained RESTful Environments",{"acronym":88,"name":89},"wit","Web and Internet Transport",{"slug":47,"name":47,"description":48},[92],{"type":51,"value":93},"10.17487\u002FRFC9997",[],[],[],[],[],[100],"YANG-CBOR","YANG-CBOR: Allocating SID Ranges for Private Enterprise Number (PEN) Holders",{"formats":103,"number":109,"abstract":110,"published":111,"status":112,"pages":113,"authors":114,"group":128,"area":131,"stream":134,"identifiers":135,"obsoletes":138,"obsoleted_by":147,"updated_by":148,"subseries":149,"updates":150,"keywords":151,"title":156},[104,105,106,107,108],{"format":9},{"format":11},{"format":13},{"format":15},{"format":17},10004,"This document provides a set of compliance statements about the Certificate Management over CMS (CMC) enrollment protocol. The ASN.1 structures and the transport mechanisms for the CMC enrollment protocol are covered in other documents (RFCs 10002 and 10003). This document provides the information needed to make a compliant version of CMC.\n\nThis document obsoletes RFCs 5274 and 6402.","2026-07-17",{"slug":74,"name":75},12,[115,122],{"titlepage_name":116,"is_editor":117,"person":118,"email":119,"affiliation":120,"country":31,"datatracker_person_path":121},"J. Mandel",true,132297,"joe@akayla.com","AKAYLA, Inc.","\u002Fperson\u002FJoe%20Mandel",{"titlepage_name":123,"is_editor":117,"person":124,"email":125,"affiliation":126,"country":31,"datatracker_person_path":127},"S. Turner",19483,"sean@sn3rd.com","sn3rd","\u002Fperson\u002FSean%20Turner",{"acronym":129,"name":130,"type":42},"lamps","Limited Additional Mechanisms for PKIX and SMIME",{"acronym":132,"name":133},"sec","Security Area",{"slug":47,"name":47,"description":48},[136],{"type":51,"value":137},"10.17487\u002FRFC10004",[139,143],{"id":140,"number":141,"title":142},127170,5274,"Certificate Management Messages over CMS (CMC): Compliance Requirements",{"id":144,"number":145,"title":146},128254,6402,"Certificate Management over CMS (CMC) Updates",[],[],[],[],[152,153,154,155],"Public Key Infrastructure","Cryptographic Message Syntax","Certificate Management","Compliance","Certificate Management over CMS (CMC): Compliance Requirements","2026-07-27T20:47:49.349Z",{"slug":159,"title":160,"description":161,"htmlObj":162,"timestampIso":385},"series\u002Frfc","What Is an RFC?","An introduction to RFCs and the organizations that produce them",[163,170,172,178,179,184,185,207,208,221,222,227,228,323,324,329,330,370,371,384],{"type":164,"nodeName":165,"attributes":166,"children":167},"Element","h1",{},[168],{"type":169,"textContent":160},"Text",{"type":169,"textContent":171},"\n",{"type":164,"nodeName":173,"attributes":174,"children":175},"p",{},[176],{"type":169,"textContent":177},"RFCs are documents that describe Internet Standards, as well as technical methods, research and other information related to the Internet and Internet-connected systems.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":180,"children":181},{},[182],{"type":169,"textContent":183},"The first RFC (Requests for Comments) was written in 1969 by Steve Crocker to organize notes related to the development of ARPANET, which paved the way for the modern Internet. Later RFCs established the foundations of the Internet itself. And today, thousands of volunteers continue to write these documents as a way to share and standardize information around the globe.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":186,"children":187},{},[188,190,197,199,205],{"type":169,"textContent":189},"Anyone is welcome to ",{"type":164,"nodeName":191,"attributes":192,"children":194},"a",{"href":193},"https:\u002F\u002Fwww.ietf.org\u002Fparticipate\u002Fget-started\u002F",[195],{"type":169,"textContent":196},"participate in the creation of RFCs",{"type":169,"textContent":198},". You can join a ",{"type":164,"nodeName":191,"attributes":200,"children":202},{"href":201},"https:\u002F\u002Fdatatracker.ietf.org\u002Fwg\u002F",[203],{"type":169,"textContent":204},"working group",{"type":169,"textContent":206}," in your area of interest by subscribing to the mailing list, participating in discussions, and contributing to the Internet-Drafts that may one day be published as an RFC.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":209,"children":210},{},[211,213,219],{"type":169,"textContent":212},"Once an RFC is published, its contents do not change. Updates and obsoletions are noted in the metadata for each RFC, and ",{"type":164,"nodeName":191,"attributes":214,"children":216},{"href":215},"\u002Fseries\u002Frfc-errata\u002F",[217],{"type":169,"textContent":218},"errata",{"type":169,"textContent":220}," may be filed for any issues with the documents.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":223,"children":224},{},[225],{"type":169,"textContent":226},"RFCs are produced via five streams:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":230,"children":231},"ul",{},[232,233,252,253,270,271,288,289,303,304,322],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":235,"children":236},"li",{},[237,243,245,250],{"type":164,"nodeName":238,"attributes":239,"children":240},"strong",{},[241],{"type":169,"textContent":242},"The Internet Engineering Task Force",{"type":169,"textContent":244}," (",{"type":164,"nodeName":191,"attributes":246,"children":248},{"href":247},"https:\u002F\u002Fwww.ietf.org\u002F",[249],{"type":169,"textContent":47},{"type":169,"textContent":251},") produces protocol standards, best current practices, experimental, and informational documents. This is the only stream that creates Internet Standards.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":254,"children":255},{},[256,261,262,268],{"type":164,"nodeName":238,"attributes":257,"children":258},{},[259],{"type":169,"textContent":260},"The Internet Research Task Force",{"type":169,"textContent":244},{"type":164,"nodeName":191,"attributes":263,"children":265},{"href":264},"https:\u002F\u002Fwww.irtf.org\u002F",[266],{"type":169,"textContent":267},"IRTF",{"type":169,"textContent":269},") focuses on longer term research issues related to the Internet.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":272,"children":273},{},[274,279,280,286],{"type":164,"nodeName":238,"attributes":275,"children":276},{},[277],{"type":169,"textContent":278},"The Internet Architecture Board",{"type":169,"textContent":244},{"type":164,"nodeName":191,"attributes":281,"children":283},{"href":282},"https:\u002F\u002Fwww.iab.org\u002F",[284],{"type":169,"textContent":285},"IAB",{"type":169,"textContent":287},") provides long-range technical direction for Internet development.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":290,"children":291},{},[292,301],{"type":164,"nodeName":191,"attributes":293,"children":295},{"href":294},"\u002Fauthors\u002Frfc-independent-submissions\u002F",[296],{"type":164,"nodeName":238,"attributes":297,"children":298},{},[299],{"type":169,"textContent":300},"Independent Submissions",{"type":169,"textContent":302}," RFCs are published outside the official processes of the IETF, IAB, and IRTF but are relevant to the Internet community.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":305,"children":306},{},[307,312,314,320],{"type":164,"nodeName":238,"attributes":308,"children":309},{},[310],{"type":169,"textContent":311},"Editorial",{"type":169,"textContent":313}," RFCs are produced by the RFC Series Working Group (",{"type":164,"nodeName":191,"attributes":315,"children":317},{"href":316},"https:\u002F\u002Fdatatracker.ietf.org\u002Fgroup\u002Frswg\u002Fabout\u002F",[318],{"type":169,"textContent":319},"RSWG",{"type":169,"textContent":321},") and document the process of publishing RFCs.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":325,"children":326},{},[327],{"type":169,"textContent":328},"For more history of the series, see:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":331,"children":332},{},[333,334,345,346,357,358,369],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":335,"children":336},{},[337,339],{"type":169,"textContent":338},"RFC 2555: ",{"type":164,"nodeName":191,"attributes":340,"children":342},{"href":341},"\u002Finfo\u002Frfc2555\u002F",[343],{"type":169,"textContent":344},"30 Years of RFCs",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":347,"children":348},{},[349,351],{"type":169,"textContent":350},"RFC 5540: ",{"type":164,"nodeName":191,"attributes":352,"children":354},{"href":353},"\u002Finfo\u002Frfc5540\u002F",[355],{"type":169,"textContent":356},"40 Years of RFCs",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":359,"children":360},{},[361,363],{"type":169,"textContent":362},"RFC 8700: ",{"type":164,"nodeName":191,"attributes":364,"children":366},{"href":365},"\u002Finfo\u002Frfc8700\u002F",[367],{"type":169,"textContent":368},"50 Years of RFCs",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":372,"children":373},{},[374,376,382],{"type":169,"textContent":375},"The official ",{"type":164,"nodeName":191,"attributes":377,"children":379},{"href":378},"https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FISSN",[380],{"type":169,"textContent":381},"International Standard Serial Number",{"type":169,"textContent":383}," (ISSN) of the RFC Series is 2070-1721.",{"type":169,"textContent":171},"2025-10-21T09:09:58+13:00",{"slug":387,"title":388,"description":389,"toc":390,"htmlObj":413,"timestampIso":579},"series\u002Frfc-errata","Errata in RFCs","Understand errors and corrections in RFCs",{"title":391,"sections":392},"Table of Contents",[393,398,403,408],{"links":394},[395],{"id":396,"title":397},"types-of-errata","Types of Errata",{"links":399},[400],{"id":401,"title":402},"statuses-of-errata","Statuses of Errata",{"links":404},[405],{"id":406,"title":407},"how-to-report-an-erratum","How to Report an Erratum",{"links":409},[410],{"id":411,"title":412},"search-for-errata","Search for Errata",[414,418,419,424,425,430,431,436,437,462,463,467,468,516,517,521,522,527,528,551,552,565,566,570,571,578],{"type":164,"nodeName":165,"attributes":415,"children":416},{},[417],{"type":169,"textContent":388},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":420,"children":421},{},[422],{"type":169,"textContent":423},"Authors and editors of RFCs carefully proofread every document prior to publication, but sometimes errors happen. Because RFCs do not change after publication, there is an errata system to note these errors.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":426,"children":427},{},[428],{"type":169,"textContent":429},"When they exist, errata are listed in the Errata section of the sidebar for each RFC. Errata with a Verified status have been reviewed and are considered accurate. Errata are not incorporated into the TXT, PDF, or XML formats of RFCs.",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":433,"children":434},"h2",{"id":396},[435],{"type":169,"textContent":397},{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":438,"children":439},{},[440,441,451,452,461],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":442,"children":443},{},[444,449],{"type":164,"nodeName":238,"attributes":445,"children":446},{},[447],{"type":169,"textContent":448},"Technical",{"type":169,"textContent":450},". There is an error in the technical content of the RFC.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":453,"children":454},{},[455,459],{"type":164,"nodeName":238,"attributes":456,"children":457},{},[458],{"type":169,"textContent":311},{"type":169,"textContent":460},". There is a spelling, grammar, punctuation, syntax, or formatting error that does not affect the technical content of the RFC.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":464,"children":465},{"id":401},[466],{"type":169,"textContent":402},{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":469,"children":470},{},[471,472,482,483,493,494,504,505,515],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":473,"children":474},{},[475,480],{"type":164,"nodeName":238,"attributes":476,"children":477},{},[478],{"type":169,"textContent":479},"Reported.",{"type":169,"textContent":481}," The erratum has been reported but has not been verified.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":484,"children":485},{},[486,491],{"type":164,"nodeName":238,"attributes":487,"children":488},{},[489],{"type":169,"textContent":490},"Verified",{"type":169,"textContent":492},". The erratum has been edited as necessary and verified by the appropriate parties.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":495,"children":496},{},[497,502],{"type":164,"nodeName":238,"attributes":498,"children":499},{},[500],{"type":169,"textContent":501},"Rejected",{"type":169,"textContent":503},". The erratum was redundant or incorrect and has been discarded.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":506,"children":507},{},[508,513],{"type":164,"nodeName":238,"attributes":509,"children":510},{},[511],{"type":169,"textContent":512},"Held for Document Update",{"type":169,"textContent":514},". The erratum is not a necessary update to the RFC. However, it should be considered in future revisions of the RFC.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":518,"children":519},{"id":406},[520],{"type":169,"textContent":407},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":523,"children":524},{},[525],{"type":169,"textContent":526},"If you find an error, you can report an erratum for the RFC.",{"type":169,"textContent":171},{"type":164,"nodeName":529,"attributes":530,"children":531},"ol",{},[532,533,538,539,544,545,550],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":534,"children":535},{},[536],{"type":169,"textContent":537},"Click \"Report a new erratum\" button in the Errata sidebar of the RFC.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":540,"children":541},{},[542],{"type":169,"textContent":543},"Search by RFC number to check if an erratum for the topic already exists. Remember to check rejected errata and errata that have been held for document updates, not just the verified errata. Click \"Report New Erratum\".",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":546,"children":547},{},[548],{"type":169,"textContent":549},"Fill out the form provided with the appropriate information. After spam screening, you will receive email notifications about your errata as it is processed, including any discussion that may arise.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":553,"children":554},{},[555,557,563],{"type":169,"textContent":556},"For more information, see ",{"type":164,"nodeName":191,"attributes":558,"children":560},{"href":559},"https:\u002F\u002Fdatatracker.ietf.org\u002Fdoc\u002Fstatement-iesg-iesg-processing-of-rfc-errata-for-the-ietf-stream-20210507\u002F",[561],{"type":169,"textContent":562},"IESG Processing of RFC Errata for the IETF Stream",{"type":169,"textContent":564},".",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":567,"children":568},{"id":411},[569],{"type":169,"textContent":412},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":572,"children":573},{},[574],{"type":164,"nodeName":575,"attributes":576,"children":577},"erratasitesearchlink",{},[],{"type":169,"textContent":171},"2026-05-08T17:35:30-07:00",{"slug":581,"title":582,"description":583,"toc":584,"htmlObj":610,"timestampIso":1120},"about\u002Frfc-editor","About the RFC Editor","RFC Editor publishes and archives official RFCs",{"title":391,"sections":585},[586,590,595,600,605],{"links":587},[588],{"id":589,"title":319},"rswg",{"links":591},[592],{"id":593,"title":594},"rsab","RSAB",{"links":596},[597],{"id":598,"title":599},"rsce","RSCE",{"links":601},[602],{"id":603,"title":604},"rpc","RPC",{"links":606},[607],{"id":608,"title":609},"governing-rfcs","Governing RFCs",[611,615,616,628,629,642,643,647,648,660,661,665,666,678,679,707,708,712,713,718,719,723,724,737,738,742,743,748,749,872,873,878,879,972,973,978,979,1053,1054,1066,1067,1119],{"type":164,"nodeName":165,"attributes":612,"children":613},{},[614],{"type":169,"textContent":582},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":617,"children":618},{},[619,621,627],{"type":169,"textContent":620},"The RFC Editor is made up of several different groups who work together to edit, publish, and archive ",{"type":164,"nodeName":191,"attributes":622,"children":624},{"href":623},"\u002Fseries\u002Frfc\u002F",[625],{"type":169,"textContent":626},"RFCs",{"type":169,"textContent":564},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":630,"children":631},{},[632,634,640],{"type":169,"textContent":633},"The current RFC Editor operating structure is defined in ",{"type":164,"nodeName":191,"attributes":635,"children":637},{"href":636},"\u002Finfo\u002Frfc9920\u002F",[638],{"type":169,"textContent":639},"RFC 9920",{"type":169,"textContent":641}," and comprises the following groups.",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":644,"children":645},{"id":589},[646],{"type":169,"textContent":319},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":649,"children":650},{},[651,653,658],{"type":169,"textContent":652},"The ",{"type":164,"nodeName":191,"attributes":654,"children":655},{"href":316},[656],{"type":169,"textContent":657},"RFC Series Working Group",{"type":169,"textContent":659}," (RSWG) generates policy proposals regarding the publication of RFCs. It is an open working group, and all interested parties are welcome to participate in policy development.",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":662,"children":663},{"id":593},[664],{"type":169,"textContent":594},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":667,"children":668},{},[669,670,676],{"type":169,"textContent":652},{"type":164,"nodeName":191,"attributes":671,"children":673},{"href":672},"https:\u002F\u002Fdatatracker.ietf.org\u002Fgroup\u002Frsab\u002Fabout\u002F",[674],{"type":169,"textContent":675},"RFC Series Approval Board",{"type":169,"textContent":677}," (RSAB) approves proposals generated by the RSWG. It provides \"checks and balances\" for the output of the RSWG and considers the long-term health of each stream and the RFC Series. The RSAB includes the following:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":680,"children":681},{},[682,683,688,689,694,695,700,701,706],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":684,"children":685},{},[686],{"type":169,"textContent":687},"representatives from each stream",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":690,"children":691},{},[692],{"type":169,"textContent":693},"the RFC Series Consulting Editor (RSCE)",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":696,"children":697},{},[698],{"type":169,"textContent":699},"the IETF LLC Director (ex officio)",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":702,"children":703},{},[704],{"type":169,"textContent":705},"an RPC representative (ex officio)",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":709,"children":710},{"id":598},[711],{"type":169,"textContent":599},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":714,"children":715},{},[716],{"type":169,"textContent":717},"The RFC Series Consulting Editor (RSCE) is a senior technical publishing professional who provides expert advice to the RFC Production Center (RPC) and RSAB on how to implement established policies on an ongoing and operational basis. This includes raising support or concerns for proposed policy updates and initiating proposed policy changes within the RSWG.",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":720,"children":721},{"id":603},[722],{"type":169,"textContent":604},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":725,"children":726},{},[727,729,735],{"type":169,"textContent":728},"The RFC Production Center (RPC) is a team of professional editors that ",{"type":164,"nodeName":191,"attributes":730,"children":732},{"href":731},"https:\u002F\u002Fauthors.ietf.org\u002Fen\u002Frfc-publication-process",[733],{"type":169,"textContent":734},"prepares and publishes RFCs",{"type":169,"textContent":736},". Once Internet-Drafts are approved by the various streams, the editors format and edit the documents, and then they work with the authors to produce publication-ready RFCs per defined policies and guidelines.",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":739,"children":740},{"id":608},[741],{"type":169,"textContent":609},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":744,"children":745},{},[746],{"type":169,"textContent":747},"The RFC Editor function is currently defined and governed by the following RFCs:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":750,"children":751},{},[752,753,764,765,776,777,788,789,800,801,812,813,824,825,836,837,848,849,860,861,871],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":754,"children":755},{},[756,762],{"type":164,"nodeName":191,"attributes":757,"children":759},{"href":758},"\u002Finfo\u002Frfc2026\u002F",[760],{"type":169,"textContent":761},"RFC 2026:",{"type":169,"textContent":763}," Bradner, S., \"The Internet Standards Process — Revision 3\", BCP 9, RFC 2026, October 1996.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":766,"children":767},{},[768,774],{"type":164,"nodeName":191,"attributes":769,"children":771},{"href":770},"\u002Finfo\u002Frfc4846\u002F",[772],{"type":169,"textContent":773},"RFC 4846:",{"type":169,"textContent":775}," Klensin, J., Ed., and D. Thaler, Ed., \"Independent Submissions to the RFC Editor\", RFC 4846, July 2007.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":778,"children":779},{},[780,786],{"type":164,"nodeName":191,"attributes":781,"children":783},{"href":782},"\u002Finfo\u002Frfc6410\u002F",[784],{"type":169,"textContent":785},"RFC 6410:",{"type":169,"textContent":787}," Housley, R., Crocker, D., and E. Burger, \"Reducing the Standards Track to Two Maturity Levels\", BCP 9, RFC 6410, October 2011.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":790,"children":791},{},[792,798],{"type":164,"nodeName":191,"attributes":793,"children":795},{"href":794},"\u002Finfo\u002Frfc8711\u002F",[796],{"type":169,"textContent":797},"RFC 8711:",{"type":169,"textContent":799}," Haberman, B., Hall, J., and J. Livingood, \"Structure of the IETF Administrative Support Activity, Version 2.0\", BCP 101, RFC 8711, February 2020.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":802,"children":803},{},[804,810],{"type":164,"nodeName":191,"attributes":805,"children":807},{"href":806},"\u002Finfo\u002Frfc8729\u002F",[808],{"type":169,"textContent":809},"RFC 8729:",{"type":169,"textContent":811}," Housley, R., Ed., and L. Daigle, Ed., \"The RFC Series and RFC Editor\", RFC 8729, February 2020.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":814,"children":815},{},[816,822],{"type":164,"nodeName":191,"attributes":817,"children":819},{"href":818},"\u002Finfo\u002Frfc8730\u002F",[820],{"type":169,"textContent":821},"RFC 8730:",{"type":169,"textContent":823}," Brownlee, N., Ed., and B. Hinden, Ed., \"Independent Submission Editor Model\", RFC 8730, February 2020.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":826,"children":827},{},[828,834],{"type":164,"nodeName":191,"attributes":829,"children":831},{"href":830},"\u002Finfo\u002Frfc9281\u002F",[832],{"type":169,"textContent":833},"RFC 9281:",{"type":169,"textContent":835}," Salz, R., \"Entities Involved in the IETF Standards Process\", BCP 11, RFC 9281, June 2022.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":838,"children":839},{},[840,846],{"type":164,"nodeName":191,"attributes":841,"children":843},{"href":842},"\u002Finfo\u002Frfc9282\u002F",[844],{"type":169,"textContent":845},"RFC 9282:",{"type":169,"textContent":847}," Rosen, B., \"Responsibility Change for the RFC Series\", RFC 9282, June 2022.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":850,"children":851},{},[852,858],{"type":164,"nodeName":191,"attributes":853,"children":855},{"href":854},"\u002Finfo\u002Frfc9283\u002F",[856],{"type":169,"textContent":857},"RFC 9283:",{"type":169,"textContent":859}," Carpenter, B., Ed., \"IAB Charter Update for RFC Editor Model\", BCP 39, RFC 9283, June 2022.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":862,"children":863},{},[864,869],{"type":164,"nodeName":191,"attributes":865,"children":866},{"href":636},[867],{"type":169,"textContent":868},"RFC 9920:",{"type":169,"textContent":870}," Hoffman, P. and A. Rossi, \"RFC Editor Model (Version 3)\", RFC 9920, February 2026.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":874,"children":875},{},[876],{"type":169,"textContent":877},"The following RFCs define particular RFC contents:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":880,"children":881},{},[882,883,894,895,906,907,918,919,930,931,942,943,961,962,971],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":884,"children":885},{},[886,892],{"type":164,"nodeName":191,"attributes":887,"children":889},{"href":888},"\u002Finfo\u002Frfc2277\u002F",[890],{"type":169,"textContent":891},"RFC 2277 (Internationalization Considerations):",{"type":169,"textContent":893}," Alvestrand, H., \"IETF Policy on Character Sets and Languages\", BCP 18, RFC 2277, January 1998.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":896,"children":897},{},[898,904],{"type":164,"nodeName":191,"attributes":899,"children":901},{"href":900},"\u002Finfo\u002Frfc3552\u002F",[902],{"type":169,"textContent":903},"RFC 3552 (Security Considerations):",{"type":169,"textContent":905}," Rescorla, E. and B. Korver, \"Guidelines for Writing RFC Text on Security Considerations\", BCP 72, RFC 3552, July 2003.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":908,"children":909},{},[910,916],{"type":164,"nodeName":191,"attributes":911,"children":913},{"href":912},"\u002Finfo\u002Frfc7322\u002F",[914],{"type":169,"textContent":915},"RFC 7322:",{"type":169,"textContent":917}," Flanagan, H. and S. Ginoza, \"RFC Style Guide\", RFC 7322, September 2014.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":920,"children":921},{},[922,928],{"type":164,"nodeName":191,"attributes":923,"children":925},{"href":924},"\u002Finfo\u002Frfc7841\u002F",[926],{"type":169,"textContent":927},"RFC 7841 (Headers and Boilerplate):",{"type":169,"textContent":929}," Halpern, J., Ed., Daigle, L., Ed., and O. Kolkman, Ed., \"RFC Streams, Headers, and Boilerplates\", RFC 7841, May 2016.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":932,"children":933},{},[934,940],{"type":164,"nodeName":191,"attributes":935,"children":937},{"href":936},"\u002Finfo\u002Frfc8126\u002F",[938],{"type":169,"textContent":939},"RFC 8126 (IANA Considerations):",{"type":169,"textContent":941}," Cotton, M., Leiba, B., and T. Narten, \"Guidelines for Writing an IANA Considerations Section in RFCs\", BCP 26, RFC 8126, June 2017.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":944,"children":945},{},[946,952,954,959],{"type":164,"nodeName":191,"attributes":947,"children":949},{"href":948},"\u002Finfo\u002Frfc8996\u002F",[950],{"type":169,"textContent":951},"RFC 8996",{"type":169,"textContent":953}," (Updates ",{"type":164,"nodeName":191,"attributes":955,"children":956},{"href":900},[957],{"type":169,"textContent":958},"RFC 3552",{"type":169,"textContent":960},"): Moriarty, K. and S. Farrell, \"Deprecating TLS 1.0 and TLS 1.1\", BCP 195, RFC 8996, March 2021.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":963,"children":964},{},[965,970],{"type":164,"nodeName":191,"attributes":966,"children":967},{"href":636},[968],{"type":169,"textContent":969},"RFC 9920 (Headers and Boilerplate for Editorial Stream):",{"type":169,"textContent":870},{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":974,"children":975},{},[976],{"type":169,"textContent":977},"The following RFCs govern intellectual property issues related to RFCs:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":980,"children":981},{},[982,983,994,995,1006,1007,1018,1019,1030,1031,1042,1043,1052],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":984,"children":985},{},[986,992],{"type":164,"nodeName":191,"attributes":987,"children":989},{"href":988},"\u002Finfo\u002Frfc5378\u002F",[990],{"type":169,"textContent":991},"RFC 5378:",{"type":169,"textContent":993}," Bradner, S., Ed., and J. Contreras, Ed., \"Rights Contributors Provide to the IETF Trust\", BCP 78, RFC 5378, November 2008.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":996,"children":997},{},[998,1004],{"type":164,"nodeName":191,"attributes":999,"children":1001},{"href":1000},"\u002Finfo\u002Frfc5743\u002F",[1002],{"type":169,"textContent":1003},"RFC 5743:",{"type":169,"textContent":1005}," Falk, A., \"Definition of an Internet Research Task Force (IRTF) Document Stream\", RFC 5743, December 2009.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1008,"children":1009},{},[1010,1016],{"type":164,"nodeName":191,"attributes":1011,"children":1013},{"href":1012},"\u002Finfo\u002Frfc5744\u002F",[1014],{"type":169,"textContent":1015},"RFC 5744:",{"type":169,"textContent":1017}," Braden, R. and J. Halpern, \"Procedures for Rights Handling in the RFC Independent Submission Stream\", RFC 5744, December 2009.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1020,"children":1021},{},[1022,1028],{"type":164,"nodeName":191,"attributes":1023,"children":1025},{"href":1024},"\u002Finfo\u002Frfc5745\u002F",[1026],{"type":169,"textContent":1027},"RFC 5745:",{"type":169,"textContent":1029}," Malis, A., Ed., and IAB, \"Procedures for Rights Handling in the RFC IAB Stream\", RFC 5745, December 2009.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1032,"children":1033},{},[1034,1040],{"type":164,"nodeName":191,"attributes":1035,"children":1037},{"href":1036},"\u002Finfo\u002Frfc8179\u002F",[1038],{"type":169,"textContent":1039},"RFC 8179:",{"type":169,"textContent":1041}," Bradner, S. and J. Contreras, \"Intellectual Property Rights in IETF Technology\", BCP 79, RFC 8179, May 2017.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1044,"children":1045},{},[1046,1051],{"type":164,"nodeName":191,"attributes":1047,"children":1048},{"href":636},[1049],{"type":169,"textContent":1050},"RFC 9920 (Editorial Stream):",{"type":169,"textContent":870},{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1055,"children":1056},{},[1057,1059,1064],{"type":169,"textContent":1058},"In addition to ",{"type":164,"nodeName":191,"attributes":1060,"children":1061},{"href":936},[1062],{"type":169,"textContent":1063},"RFC 8126",{"type":169,"textContent":1065},", the following RFCs govern RFC Editor actions with respect to particular IANA registrations:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":1068,"children":1069},{},[1070,1071,1082,1083,1094,1095,1106,1107,1118],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1072,"children":1073},{},[1074,1080],{"type":164,"nodeName":191,"attributes":1075,"children":1077},{"href":1076},"\u002Finfo\u002Frfc4289\u002F",[1078],{"type":169,"textContent":1079},"RFC 4289:",{"type":169,"textContent":1081}," Freed, N. and J. Klensin, \"Multipurpose Internet Mail Extensions (MIME) Part Four: Registration Procedures\", BCP 13, RFC 4289, December 2005.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1084,"children":1085},{},[1086,1092],{"type":164,"nodeName":191,"attributes":1087,"children":1089},{"href":1088},"\u002Finfo\u002Frfc6838\u002F",[1090],{"type":169,"textContent":1091},"RFC 6838:",{"type":169,"textContent":1093}," Freed, N., Klensin, J., and T. Hansen, \"Media Type Specifications and Registration Procedures\", BCP 13, RFC 6838, January 2013.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1096,"children":1097},{},[1098,1104],{"type":164,"nodeName":191,"attributes":1099,"children":1101},{"href":1100},"\u002Finfo\u002Frfc7595\u002F",[1102],{"type":169,"textContent":1103},"RFC 7595:",{"type":169,"textContent":1105}," Thaler, D., Ed., Hansen, T., and T. Hardie, \"Guidelines and Registration Procedures for URI Schemes\", BCP 35, RFC 7595, June 2015.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1108,"children":1109},{},[1110,1116],{"type":164,"nodeName":191,"attributes":1111,"children":1113},{"href":1112},"\u002Finfo\u002Frfc8141\u002F",[1114],{"type":169,"textContent":1115},"RFC 8141:",{"type":169,"textContent":1117}," Saint-Andre, P. and J. Klensin, \"Uniform Resource Names (URNs)\", RFC 8141, April 2017.",{"type":169,"textContent":171},{"type":169,"textContent":171},"2026-05-11T15:15:35-07:00",{"slug":1122,"title":1123,"description":1124,"toc":1125,"htmlObj":1161,"timestampIso":1674},"series\u002Frfc-tips","Tips for Reading RFCs","Helpful information about common conventions in RFCs",{"title":391,"sections":1126},[1127,1132,1137,1142,1147,1152,1156],{"links":1128},[1129],{"id":1130,"title":1131},"status","Status",{"links":1133},[1134],{"id":1135,"title":1136},"subseries","Subseries",{"links":1138},[1139],{"id":1140,"title":1141},"stream","Stream",{"links":1143},[1144],{"id":1145,"title":1146},"source","Source",{"links":1148},[1149],{"id":1150,"title":1151},"changes-to-rfcs","Changes to RFCs",{"links":1153},[1154],{"id":218,"title":1155},"Errata",{"links":1157},[1158],{"id":1159,"title":1160},"keywords-for-requirement-levels","Keywords for Requirement Levels",[1162,1166,1167,1180,1181,1185,1186,1198,1199,1204,1205,1242,1243,1248,1249,1328,1329,1333,1334,1339,1340,1366,1367,1371,1372,1377,1378,1452,1453,1458,1459,1463,1464,1469,1470,1474,1475,1480,1481,1529,1530,1534,1535,1546,1547,1551,1552,1573,1574,1673],{"type":164,"nodeName":165,"attributes":1163,"children":1164},{},[1165],{"type":169,"textContent":1123},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1168,"children":1169},{},[1170,1172,1178],{"type":169,"textContent":1171},"The RFC Series uses certain conventions that may not be familiar to all readers. Some of the most common are listed here; refer to this more ",{"type":164,"nodeName":191,"attributes":1173,"children":1175},{"href":1174},"https:\u002F\u002Fwww.ietf.org\u002Fblog\u002Fhow-read-rfc\u002F",[1176],{"type":169,"textContent":1177},"in-depth overview",{"type":169,"textContent":1179}," for further information.",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":1182,"children":1183},{"id":1130},[1184],{"type":169,"textContent":1131},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1187,"children":1188},{},[1189,1191,1197],{"type":169,"textContent":1190},"Not all RFCs are standards, so Status is used to indicate the type of RFC. ",{"type":164,"nodeName":191,"attributes":1192,"children":1194},{"href":1193},"\u002Fstatus-changes\u002F",[1195],{"type":169,"textContent":1196},"Statuses may change over time",{"type":169,"textContent":564},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1200,"children":1201},{},[1202],{"type":169,"textContent":1203},"Standards Track RFCs use the following Statuses:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":1206,"children":1207},{},[1208,1209,1219,1220,1230,1231,1241],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1210,"children":1211},{},[1212,1217],{"type":164,"nodeName":238,"attributes":1213,"children":1214},{},[1215],{"type":169,"textContent":1216},"Proposed Standard.",{"type":169,"textContent":1218}," A Proposed Standard specification is generally stable, has resolved known design choices, is believed to be well-understood, has received significant community review, and appears to enjoy enough community interest to be considered valuable. However, further experience might result in a change or even retraction of the specification before it advances.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1221,"children":1222},{},[1223,1228],{"type":164,"nodeName":238,"attributes":1224,"children":1225},{},[1226],{"type":169,"textContent":1227},"Draft Standard.",{"type":169,"textContent":1229}," An intermediate stage that is no longer used for new standards.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1232,"children":1233},{},[1234,1239],{"type":164,"nodeName":238,"attributes":1235,"children":1236},{},[1237],{"type":169,"textContent":1238},"Internet Standard.",{"type":169,"textContent":1240}," An Internet Standard is characterized by a high degree of technical maturity and by a generally held belief that the specified protocol or service provides significant benefit to the Internet community.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1244,"children":1245},{},[1246],{"type":169,"textContent":1247},"Other RFC Statuses are:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":1250,"children":1251},{},[1252,1253,1269,1270,1286,1287,1297,1298,1316,1317,1327],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1254,"children":1255},{},[1256,1261,1263],{"type":164,"nodeName":238,"attributes":1257,"children":1258},{},[1259],{"type":169,"textContent":1260},"Informational.",{"type":169,"textContent":1262}," An \"Informational\" specification is published for the general information of the Internet community, and does not represent an Internet community consensus or recommendation. ",{"type":164,"nodeName":191,"attributes":1264,"children":1266},{"href":1265},"\u002Finfo\u002Frfc2026\u002F#section-4.2.2",[1267],{"type":169,"textContent":1268},"RFC 2026, Section 4.2.2",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1271,"children":1272},{},[1273,1278,1280],{"type":164,"nodeName":238,"attributes":1274,"children":1275},{},[1276],{"type":169,"textContent":1277},"Experimental.",{"type":169,"textContent":1279}," The \"Experimental\" designation typically denotes a specification that is part of some research or development effort. Such a specification is published for the general information of the Internet technical community and as an archival record of the work. ",{"type":164,"nodeName":191,"attributes":1281,"children":1283},{"href":1282},"\u002Finfo\u002Frfc2026\u002F#section-4.2.1",[1284],{"type":169,"textContent":1285},"RFC 2026, Section 4.2.1",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1288,"children":1289},{},[1290,1295],{"type":164,"nodeName":238,"attributes":1291,"children":1292},{},[1293],{"type":169,"textContent":1294},"Historic",{"type":169,"textContent":1296},".A specification describing a technology that is no longer in use or no longer recommended for use is assigned the \"Historic\" Status.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1299,"children":1300},{},[1301,1306,1308,1314],{"type":164,"nodeName":238,"attributes":1302,"children":1303},{},[1304],{"type":169,"textContent":1305},"Best Current Practice",{"type":169,"textContent":1307}," (BCP). BCPs have a dual role: one is to document IETF processes as agreed by the IETF community, and the other is explained in ",{"type":164,"nodeName":191,"attributes":1309,"children":1311},{"href":1310},"\u002Finfo\u002Frfc2026\u002F#section-5",[1312],{"type":169,"textContent":1313},"RFC 2026, Section 5",{"type":169,"textContent":1315}," as: \"since the Internet itself is composed of networks operated by a great variety of organizations, with diverse goals and rules, good user service requires that the operators and administrators of the Internet follow some common guidelines for policies and operations.\"",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1318,"children":1319},{},[1320,1325],{"type":164,"nodeName":238,"attributes":1321,"children":1322},{},[1323],{"type":169,"textContent":1324},"Unknown",{"type":169,"textContent":1326},". RFCs that were published before Statuses were introduced (before RFC 1128) are mostly considered to have an Unknown Status, with a handful having had Statuses retroactively applied.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":1330,"children":1331},{"id":1135},[1332],{"type":169,"textContent":1136},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1335,"children":1336},{},[1337],{"type":169,"textContent":1338},"There are two current subseries within the RFC corpus. Not all RFCs are part of a subseries. Subseries identifiers are intended to be stable identifiers for an RFC or a group of related RFCs. When an RFC is obsoleted, the RFC is dropped from the subseries, but the subseries identifier will remain the same. When a related RFC is published, it may be added to an existing subseries identifier.",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":1341,"children":1342},{},[1343,1344,1354,1355,1365],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1345,"children":1346},{},[1347,1352],{"type":164,"nodeName":238,"attributes":1348,"children":1349},{},[1350],{"type":169,"textContent":1351},"STD",{"type":169,"textContent":1353},". STDs are stable identifiers for \"Internet Standards.\" An STD may consist of a single RFC or a group of RFCs related to a specific protocol.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1356,"children":1357},{},[1358,1363],{"type":164,"nodeName":238,"attributes":1359,"children":1360},{},[1361],{"type":169,"textContent":1362},"BCP",{"type":169,"textContent":1364},". BCPs are stable identifiers for Best Current Practices. A BCP may consist of a single RFC or a group of RFCs related to a specific IETF process or recommended guidelines.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":1368,"children":1369},{"id":1140},[1370],{"type":169,"textContent":1141},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1373,"children":1374},{},[1375],{"type":169,"textContent":1376},"An RFC’s stream indicates which publication stream produced the document. There are five possible streams:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":1379,"children":1380},{},[1381,1382,1396,1397,1410,1411,1424,1425,1436,1437,1451],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1383,"children":1384},{},[1385,1389,1390,1394],{"type":164,"nodeName":238,"attributes":1386,"children":1387},{},[1388],{"type":169,"textContent":242},{"type":169,"textContent":244},{"type":164,"nodeName":191,"attributes":1391,"children":1392},{"href":247},[1393],{"type":169,"textContent":47},{"type":169,"textContent":1395},") produces protocol standards, best current practices, and informational documents. This is the only stream that creates Internet Standards.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1398,"children":1399},{},[1400,1404,1405,1409],{"type":164,"nodeName":238,"attributes":1401,"children":1402},{},[1403],{"type":169,"textContent":260},{"type":169,"textContent":244},{"type":164,"nodeName":191,"attributes":1406,"children":1407},{"href":264},[1408],{"type":169,"textContent":267},{"type":169,"textContent":269},{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1412,"children":1413},{},[1414,1418,1419,1423],{"type":164,"nodeName":238,"attributes":1415,"children":1416},{},[1417],{"type":169,"textContent":278},{"type":169,"textContent":244},{"type":164,"nodeName":191,"attributes":1420,"children":1421},{"href":282},[1422],{"type":169,"textContent":285},{"type":169,"textContent":287},{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1426,"children":1427},{},[1428,1435],{"type":164,"nodeName":191,"attributes":1429,"children":1430},{"href":294},[1431],{"type":164,"nodeName":238,"attributes":1432,"children":1433},{},[1434],{"type":169,"textContent":300},{"type":169,"textContent":302},{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1438,"children":1439},{},[1440,1444,1445,1449],{"type":164,"nodeName":238,"attributes":1441,"children":1442},{},[1443],{"type":169,"textContent":311},{"type":169,"textContent":313},{"type":164,"nodeName":191,"attributes":1446,"children":1447},{"href":316},[1448],{"type":169,"textContent":319},{"type":169,"textContent":1450},") and document the policies for publishing RFCs.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1454,"children":1455},{},[1456],{"type":169,"textContent":1457},"RFCs that were published before any stream existed are given the label \"[Legacy]\" in place of a stream name.",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":1460,"children":1461},{"id":1145},[1462],{"type":169,"textContent":1146},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1465,"children":1466},{},[1467],{"type":169,"textContent":1468},"An RFC’s source indicates the IETF working group and area that produced the document. A source is only listed for RFCs produced by the IETF Stream, as the other production streams are single source.",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":1471,"children":1472},{"id":1150},[1473],{"type":169,"textContent":1151},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1476,"children":1477},{},[1478],{"type":169,"textContent":1479},"Once an RFC is published, the content of that document doesn’t change. New or updated information is published in new RFCs. When this happens, there will be information in the metadata about where to find these related documents. An RFC’s metadata may contain the following:",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":1482,"children":1483},{},[1484,1485,1495,1496,1506,1507,1517,1518,1528],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1486,"children":1487},{},[1488,1493],{"type":164,"nodeName":238,"attributes":1489,"children":1490},{},[1491],{"type":169,"textContent":1492},"Updates",{"type":169,"textContent":1494},": This document contains substantive updates to the RFCs listed here. You may need to read these RFCs to understand this document.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1497,"children":1498},{},[1499,1504],{"type":164,"nodeName":238,"attributes":1500,"children":1501},{},[1502],{"type":169,"textContent":1503},"Updated By",{"type":169,"textContent":1505},": This document has been changed by the RFCs listed here. You may need to read these RFCs to understand current practices.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1508,"children":1509},{},[1510,1515],{"type":164,"nodeName":238,"attributes":1511,"children":1512},{},[1513],{"type":169,"textContent":1514},"Obsoletes",{"type":169,"textContent":1516},": RFCs listed here are completely replaced by this document. You do not need to read the RFCs listed here to understand current practices.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1519,"children":1520},{},[1521,1526],{"type":164,"nodeName":238,"attributes":1522,"children":1523},{},[1524],{"type":169,"textContent":1525},"Obsoleted By",{"type":169,"textContent":1527},": RFCs listed here completely replace this document. In other words, you should not read this document, you should read the RFCs listed here that have obsoleted it.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":1531,"children":1532},{"id":218},[1533],{"type":169,"textContent":1155},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1536,"children":1537},{},[1538,1540,1544],{"type":169,"textContent":1539},"Errata are listed in the Errata section of the sidebar for each RFC when they exist. Errata with a Verified status have been reviewed and are considered accurate (see the ",{"type":164,"nodeName":191,"attributes":1541,"children":1542},{"href":215},[1543],{"type":169,"textContent":1155},{"type":169,"textContent":1545}," page to learn more). Errata are not incorporated into the TXT, PDF, or XML formats of RFCs. Errata only appear in the display version on this site, or the downloadable HTML version that specifically includes errata.",{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":1548,"children":1549},{"id":1159},[1550],{"type":169,"textContent":1160},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1553,"children":1554},{},[1555,1557,1563,1565,1571],{"type":169,"textContent":1556},"When you see one of the following words in all capital letters in an RFC, it has a special meaning as defined in ",{"type":164,"nodeName":191,"attributes":1558,"children":1560},{"href":1559},"\u002Finfo\u002Frfc2119\u002F",[1561],{"type":169,"textContent":1562},"RFC 2119",{"type":169,"textContent":1564}," and updated by ",{"type":164,"nodeName":191,"attributes":1566,"children":1568},{"href":1567},"\u002Finfo\u002Frfc8174\u002F",[1569],{"type":169,"textContent":1570},"RFC 8174",{"type":169,"textContent":1572},". This only applies when the words are in all capitals.",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":1575,"children":1576},{},[1577,1578,1602,1603,1620,1621,1638,1639,1655,1656,1672],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1579,"children":1580},{},[1581,1586,1588,1593,1595,1600],{"type":164,"nodeName":238,"attributes":1582,"children":1583},{},[1584],{"type":169,"textContent":1585},"MUST",{"type":169,"textContent":1587},": This word, or the terms \"",{"type":164,"nodeName":238,"attributes":1589,"children":1590},{},[1591],{"type":169,"textContent":1592},"REQUIRED",{"type":169,"textContent":1594},"\" or \"",{"type":164,"nodeName":238,"attributes":1596,"children":1597},{},[1598],{"type":169,"textContent":1599},"SHALL",{"type":169,"textContent":1601},"\", mean that the definition is an absolute requirement of the specification.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1604,"children":1605},{},[1606,1611,1613,1618],{"type":164,"nodeName":238,"attributes":1607,"children":1608},{},[1609],{"type":169,"textContent":1610},"MUST NOT",{"type":169,"textContent":1612},": This phrase, or the phrase \"",{"type":164,"nodeName":238,"attributes":1614,"children":1615},{},[1616],{"type":169,"textContent":1617},"SHALL NOT",{"type":169,"textContent":1619},"\", mean that the definition is an absolute prohibition of the specification.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1622,"children":1623},{},[1624,1629,1631,1636],{"type":164,"nodeName":238,"attributes":1625,"children":1626},{},[1627],{"type":169,"textContent":1628},"SHOULD",{"type":169,"textContent":1630},": This word, or the adjective \"",{"type":164,"nodeName":238,"attributes":1632,"children":1633},{},[1634],{"type":169,"textContent":1635},"RECOMMENDED",{"type":169,"textContent":1637},"\", mean that there may exist valid reasons in particular circumstances to ignore a particular item, but the full implications must be understood and carefully weighed before choosing a different course.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1640,"children":1641},{},[1642,1647,1648,1653],{"type":164,"nodeName":238,"attributes":1643,"children":1644},{},[1645],{"type":169,"textContent":1646},"SHOULD NOT",{"type":169,"textContent":1612},{"type":164,"nodeName":238,"attributes":1649,"children":1650},{},[1651],{"type":169,"textContent":1652},"NOT RECOMMENDED",{"type":169,"textContent":1654},"\" mean that there may exist valid reasons in particular circumstances when the particular behavior is acceptable or even useful, but the full implications should be understood and the case carefully weighed before implementing any behavior described with this label.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":1657,"children":1658},{},[1659,1664,1665,1670],{"type":164,"nodeName":238,"attributes":1660,"children":1661},{},[1662],{"type":169,"textContent":1663},"MAY",{"type":169,"textContent":1630},{"type":164,"nodeName":238,"attributes":1666,"children":1667},{},[1668],{"type":169,"textContent":1669},"OPTIONAL",{"type":169,"textContent":1671},"\", mean that an item is truly optional.",{"type":169,"textContent":171},{"type":169,"textContent":171},"2025-10-22T11:29:09+13:00",{"slug":1676,"title":1677,"description":1678,"toc":1679,"htmlObj":1702,"timestampIso":2039},"series\u002Frfc-download","Download RFCs","Download, mirror or get a feed of RFCs",{"title":391,"sections":1680},[1681,1686],{"links":1682},[1683],{"id":1684,"title":1685},"feed-of-recently-published-rfcs","Feed of recently published RFCs",{"links":1687,"sections":1691},[1688],{"id":1689,"title":1690},"download-rfcs-using-rsync","Download RFCs Using rsync",[1692,1697],{"links":1693},[1694],{"id":1695,"title":1696},"to-get-the-list-of-modules-available-type-rsync-rsync-rfc-editor-org-this-will-return-the-following-results","To get the list of modules available type rsync rsync.rfc-editor.org:: This will return the following results:",{"links":1698},[1699],{"id":1700,"title":1701},"to-create-a-mirror-using-a-module","To create a mirror using a module",[1703,1707,1708,1712,1713,1733,1734,1738,1739,1751,1752,1766,1767,1981,1982,1986,1987,1997,1998,2003,2004,2014,2015,2025,2026,2038],{"type":164,"nodeName":165,"attributes":1704,"children":1705},{},[1706],{"type":169,"textContent":1677},{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":1709,"children":1710},{"id":1684},[1711],{"type":169,"textContent":1685},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1714,"children":1715},{},[1716,1718,1724,1726,1732],{"type":169,"textContent":1717},"To be notified of newly published RFCs, use the ",{"type":164,"nodeName":191,"attributes":1719,"children":1721},{"href":1720},"\u002Frfcrss.xml",[1722],{"type":169,"textContent":1723},"RSS feed",{"type":169,"textContent":1725}," or ",{"type":164,"nodeName":191,"attributes":1727,"children":1729},{"href":1728},"\u002Frfcatom.xml",[1730],{"type":169,"textContent":1731},"Atom feed",{"type":169,"textContent":564},{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":1735,"children":1736},{"id":1689},[1737],{"type":169,"textContent":1690},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1740,"children":1741},{},[1742,1744,1750],{"type":169,"textContent":1743},"To download RFCs and keep them up to date locally, use ",{"type":164,"nodeName":191,"attributes":1745,"children":1747},{"href":1746},"https:\u002F\u002Frsync.samba.org",[1748],{"type":169,"textContent":1749},"rsync",{"type":169,"textContent":564},{"type":169,"textContent":171},{"type":164,"nodeName":1753,"attributes":1754,"children":1755},"h3",{"id":1695},[1756,1758,1764],{"type":169,"textContent":1757},"To get the list of modules available type ",{"type":164,"nodeName":1759,"attributes":1760,"children":1761},"code",{},[1762],{"type":169,"textContent":1763},"rsync rsync.rfc-editor.org::",{"type":169,"textContent":1765}," This will return the following results:",{"type":169,"textContent":171},{"type":164,"nodeName":1768,"attributes":1769,"children":1770},"table",{},[1771,1772,1797,1798,1980],{"type":169,"textContent":171},{"type":164,"nodeName":1773,"attributes":1774,"children":1775},"thead",{},[1776,1777,1796],{"type":169,"textContent":171},{"type":164,"nodeName":1778,"attributes":1779,"children":1780},"tr",{},[1781,1782,1789,1790,1795],{"type":169,"textContent":171},{"type":164,"nodeName":1783,"attributes":1784,"children":1786},"th",{"align":1785},"left",[1787],{"type":169,"textContent":1788},"Module Names",{"type":169,"textContent":171},{"type":164,"nodeName":1783,"attributes":1791,"children":1792},{"align":1785},[1793],{"type":169,"textContent":1794},"Comments",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":1799,"attributes":1800,"children":1801},"tbody",{},[1802,1803,1820,1821,1862,1863,1884,1885,1901,1902,1918,1919,1941,1942,1962,1963,1979],{"type":169,"textContent":171},{"type":164,"nodeName":1778,"attributes":1804,"children":1805},{},[1806,1807,1813,1814,1819],{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1809,"children":1810},"td",{"align":1785},[1811],{"type":169,"textContent":1812},"everything-ftp",{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1815,"children":1816},{"align":1785},[1817],{"type":169,"textContent":1818},"Everything FTP",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":1778,"attributes":1822,"children":1823},{},[1824,1825,1830,1831,1861],{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1826,"children":1827},{"align":1785},[1828],{"type":169,"textContent":1829},"rfcs",{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1832,"children":1833},{"align":1785},[1834,1836,1841,1843,1848,1849,1854,1856],{"type":169,"textContent":1835},"Contents of in-notes\u002F and subdirectories ",{"type":164,"nodeName":1759,"attributes":1837,"children":1838},{},[1839],{"type":169,"textContent":1840},"bcp\u002F",{"type":169,"textContent":1842},", ",{"type":164,"nodeName":1759,"attributes":1844,"children":1845},{},[1846],{"type":169,"textContent":1847},"fyi\u002F",{"type":169,"textContent":1842},{"type":164,"nodeName":1759,"attributes":1850,"children":1851},{},[1852],{"type":169,"textContent":1853},"ien\u002F",{"type":169,"textContent":1855},", and ",{"type":164,"nodeName":1759,"attributes":1857,"children":1858},{},[1859],{"type":169,"textContent":1860},"std\u002F",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":1778,"attributes":1864,"children":1865},{},[1866,1867,1872,1873,1883],{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1868,"children":1869},{"align":1785},[1870],{"type":169,"textContent":1871},"rfcs-text-only",{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1874,"children":1875},{"align":1785},[1876,1878],{"type":169,"textContent":1877},"Text files from ",{"type":164,"nodeName":1759,"attributes":1879,"children":1880},{},[1881],{"type":169,"textContent":1882},"[rfcs]",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":1778,"attributes":1886,"children":1887},{},[1888,1889,1894,1895,1900],{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1890,"children":1891},{"align":1785},[1892],{"type":169,"textContent":1893},"rfc-ed-all",{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1896,"children":1897},{"align":1785},[1898],{"type":169,"textContent":1899},"Entire repository (excluding Internet-Drafts)",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":1778,"attributes":1903,"children":1904},{},[1905,1906,1911,1912,1917],{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1907,"children":1908},{"align":1785},[1909],{"type":169,"textContent":1910},"rfcs-pdf-only",{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1913,"children":1914},{"align":1785},[1915],{"type":169,"textContent":1916},"PDF versions of ASCII RFCs to ensure correct page breaks, etc.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":1778,"attributes":1920,"children":1921},{},[1922,1923,1928,1929,1940],{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1924,"children":1925},{"align":1785},[1926],{"type":169,"textContent":1927},"rfcs-exclude-json",{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1930,"children":1931},{"align":1785},[1932,1934,1938],{"type":169,"textContent":1933},"Contents of ",{"type":164,"nodeName":1759,"attributes":1935,"children":1936},{},[1937],{"type":169,"textContent":1882},{"type":169,"textContent":1939}," excluding JSON files",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":1778,"attributes":1943,"children":1944},{},[1945,1946,1951,1952,1961],{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1947,"children":1948},{"align":1785},[1949],{"type":169,"textContent":1950},"rfcs-json-only",{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1953,"children":1954},{"align":1785},[1955,1957],{"type":169,"textContent":1956},"Only the JSON files from the directories in ",{"type":164,"nodeName":1759,"attributes":1958,"children":1959},{},[1960],{"type":169,"textContent":1882},{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":1778,"attributes":1964,"children":1965},{},[1966,1967,1972,1973,1978],{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1968,"children":1969},{"align":1785},[1970],{"type":169,"textContent":1971},"rfcs-pdf-all",{"type":169,"textContent":171},{"type":164,"nodeName":1808,"attributes":1974,"children":1975},{"align":1785},[1976],{"type":169,"textContent":1977},"All PDFs",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":1753,"attributes":1983,"children":1984},{"id":1700},[1985],{"type":169,"textContent":1701},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1988,"children":1989},{},[1990,1992],{"type":169,"textContent":1991},"Type ",{"type":164,"nodeName":1759,"attributes":1993,"children":1994},{},[1995],{"type":169,"textContent":1996},"rsync -avz --delete rsync.rfc-editor.org::Module-Name Target-Directory",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":1999,"children":2000},{},[2001],{"type":169,"textContent":2002},"For example: To create a mirror of the text versions of all the RFCs, i.e.,",{"type":169,"textContent":171},{"type":164,"nodeName":2005,"attributes":2006,"children":2007},"pre",{},[2008],{"type":164,"nodeName":1759,"attributes":2009,"children":2011},{"class":2010},"language-text",[2012],{"type":169,"textContent":2013},"\nin-notes\u002F*.txt\nin-notes\u002Fbcp\u002F*.txt\nin-notes\u002Ffyi\u002F*.txt\nin-notes\u002Fien\u002F*.txt\nin-notes\u002Fstd\u002F*.txt\n",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2016,"children":2017},{},[2018,2020],{"type":169,"textContent":2019},"type ",{"type":164,"nodeName":1759,"attributes":2021,"children":2022},{},[2023],{"type":169,"textContent":2024},"rsync -avz --delete rsync.rfc-editor.org::rfcs-text-only my-rfc-mirror",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2027,"children":2028},{},[2029,2031,2036],{"type":169,"textContent":2030},"(The ",{"type":164,"nodeName":1759,"attributes":2032,"children":2033},{},[2034],{"type":169,"textContent":2035},"--delete",{"type":169,"textContent":2037}," option is useful for removing local copies of files that have been deleted from the repository as well as expired Internet-Drafts.)",{"type":169,"textContent":171},"2026-05-05T11:00:11+12:00",{"slug":2041,"title":300,"description":2042,"toc":2043,"htmlObj":2050,"timestampIso":2851},"authors\u002Frfc-independent-submissions","How the Independent Submission Stream works.",{"title":391,"sections":2044},[2045],{"links":2046},[2047],{"id":2048,"title":2049},"publishing-an-independent-submission","Publishing an Independent Submission",[2051,2055,2056,2091,2092,2116,2117,2137,2138,2148,2149,2153,2154,2328,2329,2334,2335,2340,2341,2346,2347,2369,2370,2375,2376,2381,2382,2391,2392,2396,2397,2449,2450,2454,2455,2468,2469,2473,2474,2486,2487,2491,2492,2497,2498,2502,2503,2527,2528,2603,2604,2609,2610,2614,2615,2639,2640,2644,2645,2665,2666,2676,2677,2681,2682,2707,2708,2712,2713,2718,2719,2727,2728,2732,2733,2746,2747,2751,2752,2757,2758,2763,2764,2768,2769,2774,2775,2779,2780,2792,2793,2797,2798,2803,2804,2815,2816,2820,2821,2834,2835,2839,2840,2850],{"type":164,"nodeName":165,"attributes":2052,"children":2053},{},[2054],{"type":169,"textContent":300},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2057,"children":2058},{},[2059,2061,2065,2066,2071,2072,2076,2078,2083,2085,2089],{"type":169,"textContent":2060},"The Independent Submission Stream allows RFC publication for some documents that are outside the official processes of the ",{"type":164,"nodeName":191,"attributes":2062,"children":2063},{"href":247},[2064],{"type":169,"textContent":47},{"type":169,"textContent":1842},{"type":164,"nodeName":191,"attributes":2067,"children":2069},{"href":2068},"https:\u002F\u002Fwww.iab.com\u002F",[2070],{"type":169,"textContent":285},{"type":169,"textContent":1855},{"type":164,"nodeName":191,"attributes":2073,"children":2074},{"href":264},[2075],{"type":169,"textContent":267},{"type":169,"textContent":2077}," but are relevant to the Internet community and achieve reasonable levels of technical and editorial quality. Note that RFCs published as independent submissions do not require, nor do they carry, community consensus, and they are not standards or best practices. ",{"type":164,"nodeName":191,"attributes":2079,"children":2080},{"href":818},[2081],{"type":169,"textContent":2082},"RFC 8730, \"Independent Submission Editor Model\"",{"type":169,"textContent":2084},", as updated by ",{"type":164,"nodeName":191,"attributes":2086,"children":2087},{"href":636},[2088],{"type":169,"textContent":639},{"type":169,"textContent":2090},", describes the roles of",{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":2093,"children":2094},{},[2095,2096,2101,2102,2115],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2097,"children":2098},{},[2099],{"type":169,"textContent":2100},"the Independent Submissions Editor (ISE) and",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2103,"children":2104},{},[2105,2107,2113],{"type":169,"textContent":2106},"the ",{"type":164,"nodeName":191,"attributes":2108,"children":2110},{"href":2109},"\u002Fauthors\u002Fise\u002Fiseb",[2111],{"type":169,"textContent":2112},"Independent Submissions Editorial Board",{"type":169,"textContent":2114},", which provides review for the ISE.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2118,"children":2119},{},[2120,2122,2128,2130,2136],{"type":169,"textContent":2121},"The Independent Submissions Editor (ISE) is currently ",{"type":164,"nodeName":191,"attributes":2123,"children":2125},{"href":2124},"https:\u002F\u002Fdatatracker.ietf.org\u002Fperson\u002Flear@lear.ch",[2126],{"type":169,"textContent":2127},"Eliot Lear",{"type":169,"textContent":2129},", who can be reached at ",{"type":164,"nodeName":191,"attributes":2131,"children":2133},{"href":2132},"mailto:rfc-ise@rfc-editor.org",[2134],{"type":169,"textContent":2135},"rfc-ise@rfc-editor.org",{"type":169,"textContent":564},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2139,"children":2140},{},[2141,2147],{"type":164,"nodeName":191,"attributes":2142,"children":2144},{"href":2143},"\u002Fauthors\u002Fise\u002Fise-checklist",[2145],{"type":169,"textContent":2146},"Click here for steps to start the publication process",{"type":169,"textContent":564},{"type":169,"textContent":171},{"type":164,"nodeName":432,"attributes":2150,"children":2151},{"id":2048},[2152],{"type":169,"textContent":2049},{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":2155,"children":2156},{},[2157,2158,2167,2168,2177,2178,2187,2188,2197,2198,2207,2208,2217,2218,2227,2228,2237,2238,2247,2248,2257,2258,2267,2268,2277,2278,2287,2288,2297,2298,2307,2308,2317,2318,2327],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2159,"children":2160},{},[2161],{"type":164,"nodeName":191,"attributes":2162,"children":2164},{"href":2163},"#what-sort-of-documents-are-independent-submissions",[2165],{"type":169,"textContent":2166},"What sort of documents are independent submissions?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2169,"children":2170},{},[2171],{"type":164,"nodeName":191,"attributes":2172,"children":2174},{"href":2173},"#what-are-some-examples-of-rfcs-published-through-the-independent-stream-that-hit-at-least-one-of-those-points",[2175],{"type":169,"textContent":2176},"What are some examples of RFCs published through the Independent Stream that hit at least one of those points?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2179,"children":2180},{},[2181],{"type":164,"nodeName":191,"attributes":2182,"children":2184},{"href":2183},"#what-other-criteria-are-there-for-independent-stream-rfcs",[2185],{"type":169,"textContent":2186},"What other criteria are there for Independent Stream RFCs?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2189,"children":2190},{},[2191],{"type":164,"nodeName":191,"attributes":2192,"children":2194},{"href":2193},"#what-if-a-document-isnt-appropriate-as-an-independent-submission",[2195],{"type":169,"textContent":2196},"What if a document isn’t appropriate as an independent submission?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2199,"children":2200},{},[2201],{"type":164,"nodeName":191,"attributes":2202,"children":2204},{"href":2203},"#what-about-intellectual-property-rights-ipr",[2205],{"type":169,"textContent":2206},"What about Intellectual Property Rights (IPR)?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2209,"children":2210},{},[2211],{"type":164,"nodeName":191,"attributes":2212,"children":2214},{"href":2213},"#whats-the-process",[2215],{"type":169,"textContent":2216},"What’s the process?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2219,"children":2220},{},[2221],{"type":164,"nodeName":191,"attributes":2222,"children":2224},{"href":2223},"#at-what-stage-is-a-document",[2225],{"type":169,"textContent":2226},"At what stage is a document?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2229,"children":2230},{},[2231],{"type":164,"nodeName":191,"attributes":2232,"children":2234},{"href":2233},"#who-makes-decisions-about-independent-submissions",[2235],{"type":169,"textContent":2236},"Who makes decisions about independent submissions?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2239,"children":2240},{},[2241],{"type":164,"nodeName":191,"attributes":2242,"children":2244},{"href":2243},"#who-reviews-submissions",[2245],{"type":169,"textContent":2246},"Who reviews submissions?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2249,"children":2250},{},[2251],{"type":164,"nodeName":191,"attributes":2252,"children":2254},{"href":2253},"#where-can-reviews-be-found",[2255],{"type":169,"textContent":2256},"Where can reviews be found?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2259,"children":2260},{},[2261],{"type":164,"nodeName":191,"attributes":2262,"children":2264},{"href":2263},"#what-is-ietf-conflict-review",[2265],{"type":169,"textContent":2266},"What is IETF Conflict Review?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2269,"children":2270},{},[2271],{"type":164,"nodeName":191,"attributes":2272,"children":2274},{"href":2273},"#how-is-a-decision-made",[2275],{"type":169,"textContent":2276},"How is a decision made?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2279,"children":2280},{},[2281],{"type":164,"nodeName":191,"attributes":2282,"children":2284},{"href":2283},"#what-happens-if-a-work-is-declined",[2285],{"type":169,"textContent":2286},"What happens if a work is declined?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2289,"children":2290},{},[2291],{"type":164,"nodeName":191,"attributes":2292,"children":2294},{"href":2293},"#can-an-independent-submission-be-changed-once-it-is-published-as-an-rfc",[2295],{"type":169,"textContent":2296},"Can an Independent Submission be changed once it is published as an RFC?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2299,"children":2300},{},[2301],{"type":164,"nodeName":191,"attributes":2302,"children":2304},{"href":2303},"#what-is-the-conflict-of-interest-policy",[2305],{"type":169,"textContent":2306},"What is the Conflict of Interest Policy?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2309,"children":2310},{},[2311],{"type":164,"nodeName":191,"attributes":2312,"children":2314},{"href":2313},"#how-can-i-submit-an-april-1st-rfc",[2315],{"type":169,"textContent":2316},"How can I submit an April 1st RFC?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2319,"children":2320},{},[2321],{"type":164,"nodeName":191,"attributes":2322,"children":2324},{"href":2323},"#more-questions",[2325],{"type":169,"textContent":2326},"More questions?",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2331,"children":2332},"h4",{},[2333],{"type":169,"textContent":2166},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2336,"children":2337},{},[2338],{"type":169,"textContent":2339},"The Independent Stream covers a number of classes of submissions, including discussions of technologies, options, or experience with protocols; humor; documentation of vendor-specific protocols; introduction of new ideas that may not yet be ripe for standardization; critiques of the IETF process; and a few other areas.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2342,"children":2343},{},[2344],{"type":169,"textContent":2345},"The current Independent Submissions Editor looks at a document through the lens of three questions:",{"type":169,"textContent":171},{"type":164,"nodeName":529,"attributes":2348,"children":2349},{},[2350,2351,2356,2357,2362,2363,2368],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2352,"children":2353},{},[2354],{"type":169,"textContent":2355},"Does this specification improve interoperability?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2358,"children":2359},{},[2360],{"type":169,"textContent":2361},"Does this document contribute to continuous improvement of the Internet?",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2364,"children":2365},{},[2366],{"type":169,"textContent":2367},"Does this document provide the community some levity?",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2371,"children":2372},{},[2373],{"type":169,"textContent":2374},"Not every submission needs to hit all three points.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2377,"children":2378},{},[2379],{"type":169,"textContent":2380},"The following figure depicts the different streams that feed into the RFC Series",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2383,"children":2384},{},[2385],{"type":164,"nodeName":2386,"attributes":2387,"children":2390},"img",{"src":2388,"alt":2389},"\u002Fimages\u002Fauthors\u002Frfc-independent-submissions-streams.png","A description of the different streams that feed into the RFC series.  Once initially approved for publication, they are processed by the RFC Production Center, and then go on to be published.",[],{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2393,"children":2394},{},[2395],{"type":169,"textContent":2176},{"type":169,"textContent":171},{"type":164,"nodeName":229,"attributes":2398,"children":2399},{},[2400,2401,2412,2413,2424,2425,2436,2437,2448],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2402,"children":2403},{},[2404,2410],{"type":164,"nodeName":191,"attributes":2405,"children":2407},{"href":2406},"\u002Finfo\u002Frfc9446\u002F",[2408],{"type":169,"textContent":2409},"RFC 9446",{"type":169,"textContent":2411}," provides us a retrospective on ten years after the Snowden revelations, how the community reacted, what was accomplished, and what could be done better.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2414,"children":2415},{},[2416,2422],{"type":164,"nodeName":191,"attributes":2417,"children":2419},{"href":2418},"\u002Finfo\u002Frfc9518\u002F",[2420],{"type":169,"textContent":2421},"RFC 9518",{"type":169,"textContent":2423}," talks about Internet centralization, its impact, and what, if anything, can be done about it.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2426,"children":2427},{},[2428,2434],{"type":164,"nodeName":191,"attributes":2429,"children":2431},{"href":2430},"\u002Finfo\u002Frfc9405\u002F",[2432],{"type":169,"textContent":2433},"RFC 9405",{"type":169,"textContent":2435}," discusses sarcasm in AI systems, and was written in part by ChatGPT.",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2438,"children":2439},{},[2440,2446],{"type":164,"nodeName":191,"attributes":2441,"children":2443},{"href":2442},"\u002Finfo\u002Frfc9383\u002F",[2444],{"type":169,"textContent":2445},"RFC 9383",{"type":169,"textContent":2447}," specifies the SPAKE2+ augmented password-authenticated key exchange (PAKE) protocol.",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2451,"children":2452},{},[2453],{"type":169,"textContent":2186},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2456,"children":2457},{},[2458,2460,2466],{"type":169,"textContent":2459},"Documents must be well written, accurate, concise, and appropriate for the readership of the RFC series. They must not present security or operational risks to the Internet, they must adhere to any ",{"type":164,"nodeName":191,"attributes":2461,"children":2463},{"href":2462},"https:\u002F\u002Fiana.org\u002F",[2464],{"type":169,"textContent":2465},"IANA",{"type":169,"textContent":2467}," rules for code point allocation, and in general may not create new IANA registries. Internal implementation descriptions are generally not accepted, nor are foundational formats upon which standards are expected to be built.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2470,"children":2471},{},[2472],{"type":169,"textContent":2196},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2475,"children":2476},{},[2477,2479,2484],{"type":169,"textContent":2478},"If a document is not appropriate as an independent submission, the Independent Submissions Editor will attempt to assist the authors to find a more appropriate home. That could be the IETF, the ",{"type":164,"nodeName":191,"attributes":2480,"children":2482},{"href":2481},"https:\u002F\u002Firtf.org\u002F",[2483],{"type":169,"textContent":267},{"type":169,"textContent":2485},", some other standards organization, a blog, or an academic publication.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2488,"children":2489},{},[2490],{"type":169,"textContent":2206},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2493,"children":2494},{},[2495],{"type":169,"textContent":2496},"An independent RFC should generally provide an open license to implement and deploy some or all of the technology described in the document; text from that document is available to be reused for any purpose.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2499,"children":2500},{},[2501],{"type":169,"textContent":2216},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2504,"children":2505},{},[2506,2511,2513,2519,2521,2525],{"type":164,"nodeName":2386,"attributes":2507,"children":2510},{"src":2508,"alt":2509},"\u002Fimages\u002Fauthors\u002Frfc-independent-submissions-process.png","The publication pipeline: steps include submission, initial evaluation, document updates, commissioned reviews, ISE review, more document updates, IESG conflict review, more document updates, publication request, to the RPC and final edits (AUTH48).",[],{"type":169,"textContent":2512},"\nEverything begins with an Internet-Draft. You can use the same tooling that is used by the IETF to create and publish it onto the Datatracker. See ",{"type":164,"nodeName":191,"attributes":2514,"children":2516},{"href":2515},"https:\u002F\u002Fauthors.ietf.org",[2517],{"type":169,"textContent":2518},"authors.ietf.org",{"type":169,"textContent":2520}," for more information about authoring tools.",{"type":164,"nodeName":2522,"attributes":2523,"children":2524},"br",{},[],{"type":169,"textContent":2526},"\nThe rest of the process is summarized as follows:",{"type":169,"textContent":171},{"type":164,"nodeName":529,"attributes":2529,"children":2530},{},[2531,2532,2537,2538,2543,2544,2549,2550,2555,2556,2561,2562,2567,2568,2573,2574,2578,2579,2584,2585,2590,2591,2596,2597,2602],{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2533,"children":2534},{},[2535],{"type":169,"textContent":2536},"Submit a draft",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2539,"children":2540},{},[2541],{"type":169,"textContent":2542},"Fill out the independent submissions template",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2545,"children":2546},{},[2547],{"type":169,"textContent":2548},"Submit the template to the Independent Submissions Editor",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2551,"children":2552},{},[2553],{"type":169,"textContent":2554},"Initial ISE review",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2557,"children":2558},{},[2559],{"type":169,"textContent":2560},"Commissioned reviews",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2563,"children":2564},{},[2565],{"type":169,"textContent":2566},"Follow-up ISE review",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2569,"children":2570},{},[2571],{"type":169,"textContent":2572},"IETF Conflict Review",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2575,"children":2576},{},[2577],{"type":169,"textContent":2566},{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2580,"children":2581},{},[2582],{"type":169,"textContent":2583},"Initial publication decision",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2586,"children":2587},{},[2588],{"type":169,"textContent":2589},"Submission to the RFC Production Center (RPC)",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2592,"children":2593},{},[2594],{"type":169,"textContent":2595},"AUTH48",{"type":169,"textContent":171},{"type":164,"nodeName":234,"attributes":2598,"children":2599},{},[2600],{"type":169,"textContent":2601},"Publication",{"type":169,"textContent":171},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2605,"children":2606},{},[2607],{"type":169,"textContent":2608},"It’s important to note that many drafts do not make it past Step 4, and that every step after submission may be iterated or repeated. For instance, if external review indicates that substantial amounts of work are needed, authors are expected to improve the document in discussions with reviewers and the Independent Submissions Editor.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2611,"children":2612},{},[2613],{"type":169,"textContent":2226},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2616,"children":2617},{},[2618,2620,2626,2628,2631,2632,2637],{"type":169,"textContent":2619},"Information about the current state of an independent submission can be found on the ",{"type":164,"nodeName":191,"attributes":2621,"children":2623},{"href":2622},"https:\u002F\u002Fdatatracker.ietf.org\u002F",[2624],{"type":169,"textContent":2625},"Datatracker",{"type":169,"textContent":2627}," page for that draft.",{"type":164,"nodeName":2522,"attributes":2629,"children":2630},{},[],{"type":169,"textContent":171},{"type":164,"nodeName":2386,"attributes":2633,"children":2636},{"src":2634,"alt":2635},"\u002Fimages\u002Fauthors\u002Frfc-independent-submissions-snapshot.png","Snapshot of a Datatracker entry for an Internet-Draft that shows the document’s state.",[],{"type":169,"textContent":2638},"\nNote that a document can sometimes appear to go \"backwards\" in the process. This is not unusual, indicating that either additional reviews require more work on someone’s part.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2641,"children":2642},{},[2643],{"type":169,"textContent":2236},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2646,"children":2647},{},[2648,2650,2655,2657,2663],{"type":169,"textContent":2649},"The Independent Submissions Editor is responsible for making decisions about each submission, in accordance with the guidance set forth in ",{"type":164,"nodeName":191,"attributes":2651,"children":2652},{"href":770},[2653],{"type":169,"textContent":2654},"RFC 4846",{"type":169,"textContent":2656},". The Independent Submissions Editor is appointed by the ",{"type":164,"nodeName":191,"attributes":2658,"children":2660},{"href":2659},"https:\u002F\u002Fiab.org\u002F",[2661],{"type":169,"textContent":2662},"Internet Architecture Board (IAB)",{"type":169,"textContent":2664},", and serves at their pleasure. Anyone may send comments to the IAB about the Independent Submissions Editor.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2667,"children":2668},{},[2669,2671,2675],{"type":169,"textContent":2670},"The Independent Submissions Editor is ably assisted by the ",{"type":164,"nodeName":191,"attributes":2672,"children":2673},{"href":2109},[2674],{"type":169,"textContent":2112},{"type":169,"textContent":564},{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2678,"children":2679},{},[2680],{"type":169,"textContent":2246},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2683,"children":2684},{},[2685,2687,2691,2693,2698,2700,2706],{"type":169,"textContent":2686},"The Independent Submissions Editor seeks review of the work through individuals who are knowledgeable about the topic discussed in the draft. Authors are encouraged to submit suggestions, but some reviews will be conducted outside of that list. The ISE often relies on the ",{"type":164,"nodeName":191,"attributes":2688,"children":2689},{"href":2109},[2690],{"type":169,"textContent":2112},{"type":169,"textContent":2692}," to provide reviews. In addition, the ISE welcomes comments from ",{"type":164,"nodeName":238,"attributes":2694,"children":2695},{},[2696],{"type":169,"textContent":2697},"anyone",{"type":169,"textContent":2699}," on a draft that is being considered by the ISE. Information for reviewers can be found ",{"type":164,"nodeName":191,"attributes":2701,"children":2703},{"href":2702},"\u002Fauthors\u002Fise\u002Fise-reviewer-guidelines",[2704],{"type":169,"textContent":2705},"here",{"type":169,"textContent":564},{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2709,"children":2710},{},[2711],{"type":169,"textContent":2256},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2714,"children":2715},{},[2716],{"type":169,"textContent":2717},"Unless they have been submitted anonymously, reviews are provided to authors and will be provided to others upon request.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2720,"children":2721},{},[2722],{"type":164,"nodeName":2386,"attributes":2723,"children":2726},{"src":2724,"alt":2725},"\u002Fimages\u002Fauthors\u002Frfc-independent-submissions-reviews.png","Snapshot of the Datatracker entry for a draft that shows reviews.",[],{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2729,"children":2730},{},[2731],{"type":169,"textContent":2266},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2734,"children":2735},{},[2736,2738,2744],{"type":169,"textContent":2737},"In general, submissions should not conflict with IETF work or established best practices. ",{"type":164,"nodeName":191,"attributes":2739,"children":2741},{"href":2740},"\u002Finfo\u002Frfc5742\u002F",[2742],{"type":169,"textContent":2743},"RFC 5742",{"type":169,"textContent":2745}," provides the IESG the opportunity to comment about whether this is the case. Most of the time, a document will not get to the stage of the IESG even being consulted if such a conflict is likely. If the IESG determines that there is a conflict of some form, the ISE will attempt to work with authors and the IESG to resolve it satisfactorily.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2748,"children":2749},{},[2750],{"type":169,"textContent":2276},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2753,"children":2754},{},[2755],{"type":169,"textContent":2756},"The Independent Submissions Editor takes into account the preponderance of reviews, as well as the IESG’s input, in making a publication determination as to whether the document can be published. If it cannot, in some cases, this may be rectified with additional work by the authors. In other cases, the publication decision is final.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2759,"children":2760},{},[2761],{"type":169,"textContent":2762},"The Independent Submissions Editor reserves the right to not publish any work up until the point that it has been released as an RFC.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2765,"children":2766},{},[2767],{"type":169,"textContent":2286},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2770,"children":2771},{},[2772],{"type":169,"textContent":2773},"Authors may seek further review of their work, either by the Independent Submissions Editor or by the IAB, who may choose to review a document or not. If it does, then the IAB will advise the Independent Submissions Editor as to their views. In all cases, the Independent Submissions Editor makes the final decision.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2776,"children":2777},{},[2778],{"type":169,"textContent":2296},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2781,"children":2782},{},[2783,2785,2791],{"type":169,"textContent":2784},"No. RFCs are all but immutable. However, anyone may submit an erratum about any RFC, and those that are accepted will be noted on the RFC info page and ",{"type":164,"nodeName":191,"attributes":2786,"children":2788},{"href":2787},"https:\u002F\u002Ferrata.rfc-editor.org",[2789],{"type":169,"textContent":2790},"RFC errata site",{"type":169,"textContent":564},{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2794,"children":2795},{},[2796],{"type":169,"textContent":2306},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2799,"children":2800},{},[2801],{"type":169,"textContent":2802},"From time to time, the Independent Submissions Editor may have a conflict of interest, or the appearance of a conflict of interest, with regard to a particular draft. This can occur for a number of reasons, for example, a document submitted by an author that is employed by the same employer as the ISE or one of its competitors. Such relationships in and of themselves may not lead to variance in the editorial process, but they must be disclosed.",{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2805,"children":2806},{},[2807,2809,2813],{"type":169,"textContent":2808},"When the ISE believes that there may be a conflict of interest, or if authors or others believe that there may be a conflict of interest, the matter will be referred to the ",{"type":164,"nodeName":191,"attributes":2810,"children":2811},{"href":2109},[2812],{"type":169,"textContent":2112},{"type":169,"textContent":2814},". They will advise the ISE as to what should happen at the various stages of the publication process. The ISE will inform the community and authors of such conflicts, and any actions to be taken as a result.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2817,"children":2818},{},[2819],{"type":169,"textContent":2316},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2822,"children":2823},{},[2824,2826,2832],{"type":169,"textContent":2825},"April 1st submissions are the only RFCs-to-be that are not posted as Internet-Drafts. These entries should be sent directly to the ",{"type":164,"nodeName":191,"attributes":2827,"children":2829},{"href":2828},"mailto:rfc-editor@rfc-editor.org",[2830],{"type":169,"textContent":2831},"RFC Editor",{"type":169,"textContent":2833},". Please send all entries by early March, so that by mid March the ISE can hand over the selected documents to the RPC for editing and publication.",{"type":169,"textContent":171},{"type":164,"nodeName":2330,"attributes":2836,"children":2837},{},[2838],{"type":169,"textContent":2326},{"type":169,"textContent":171},{"type":164,"nodeName":173,"attributes":2841,"children":2842},{},[2843,2845,2849],{"type":169,"textContent":2844},"We are happy to answer any questions you might have. Contact us at ",{"type":164,"nodeName":191,"attributes":2846,"children":2847},{"href":2132},[2848],{"type":169,"textContent":2135},{"type":169,"textContent":564},{"type":169,"textContent":171},"2026-05-08T21:16:58+12:00",["Reactive",2853],{"$scolor-mode":2854},{"preference":2855,"value":2855,"unknown":117,"forced":28},"system",["Set"],["ShallowReactive",2858],{"$oQk39TZTLu":-1,"markdown-card-series\u002Frfc":-1,"markdown-card-series\u002Frfc-tips":-1,"markdown-card-series\u002Frfc-errata":-1,"markdown-card-about\u002Frfc-editor":-1,"markdown-card-series\u002Frfc-download":-1,"markdown-card-authors\u002Frfc-independent-submissions":-1},"\u002F",["Reactive",2861],{"uiSettings":2862},{"obsoletedByMode":2863,"updatedByMode":2865,"disableRFCLinkPreview":2866},["Ref",2864],"compact",["Ref",2864],["EmptyRef",2867],"false"]</script><!----><!----><!----></body></html>