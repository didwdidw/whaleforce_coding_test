    - /url: https://www.google.com/search?as_eq=wikipedia&q=%22Ticker+symbol%22
  - text: –
  - link "news":
    - /url: https://www.google.com/search?tbm=nws&q=%22Ticker+symbol%22+-wikipedia&tbs=ar:1
  - text: ·
  - link "newspapers":
