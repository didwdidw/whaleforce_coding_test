<li id="mwAqc"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hubei_Golden_Ring_Co_Ltd?action=edit&amp;redlink=1" title="Hubei Golden Ring Co Ltd (page does not exist)" about="#mwt83" typeof="mw:Transclusion mw:LocalizedAttrs" class="new" id="mwAqg" data-mw="{&quot;parts&quot;:[{&quot;template&quot;:{&quot;target&quot;:{&quot;wt&quot;:&quot;Interlanguage link&quot;,&quot;href&quot;:&quot;./Template:Interlanguage_link&quot;},&quot;params&quot;:{&quot;1&quot;:{&quot;wt&quot;:&quot;Hubei Golden Ring Co Ltd&quot;},&quot;2&quot;:{&quot;wt&quot;:&quot;zh&quot;},&quot;3&quot;:{&quot;wt&quot;:&quot;湖北金環&quot;}},&quot;i&quot;:0}}]}" data-mw-i18n="{&quot;title&quot;:{&quot;lang&quot;:&quot;x-page&quot;,&quot;key&quot;:&quot;red-link-title&quot;,&quot;params&quot;:[&quot;Hubei Golden Ring Co Ltd&quot;]}}">Hubei Golden Ring Co Ltd</a><span class="noprint" style="font-size:85%; font-style: normal; " about="#mwt83" id="mwAqk"><span typeof="mw:Entity">&nbsp;</span><span typeof="mw:Entity">[</span><a rel="mw:WikiLink/Interwiki" href="https://zh.wikipedia.org/wiki/湖北金環" title="zh:湖北金環" class="extiw">zh</a><span typeof="mw:Entity">]</span></span><span typeof="mw:Entity" id="mwAqo">&nbsp;</span>– 000615 [Shenzhen<span typeof="mw:Entity" id="mwAqs">&nbsp;</span>– China]</li>
